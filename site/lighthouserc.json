{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-out.mjs 3220",
      "startServerReadyPattern": "serve-out",
      "url": ["http://127.0.0.1:3220/", "http://127.0.0.1:3220/protocols/kamino-lend/"],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop", "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
